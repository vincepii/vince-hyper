# 5. SwayNC CSS Colors (~/.config/swaync/colors.css) — overrides :root defaults + @define-color fallbacks
cat > "$HOME/.config/swaync/colors.css" <<EOF
/* Auto-generated by theme-switcher ($NAME) */
:root {
  --cc-bg: $BG_RGBA;
  --noti-border-color: $ACCENT;
  --noti-bg: $BG_RGB;
  --noti-bg-alpha: 0.96;
  --noti-bg-darker: $BG;
  --noti-bg-hover: rgba($ACCENT_RGB, 0.14);
  --noti-bg-focus: rgba($ACCENT_RGB, 0.20);
  --noti-close-bg: rgba($ACCENT_RGB, 0.16);
  --noti-close-bg-hover: $URGENT;
  --text-color: $FG;
  --text-color-disabled: $FG_DIM;
  --bg-selected: $ACCENT;
  --notification-icon-size: 36px;
  --font-size-summary: 13.5px;
  --font-size-body: 12.5px;
}

@define-color cc-bg $BG_RGBA;
@define-color noti-border-color $ACCENT;
@define-color noti-bg rgba($BG_RGB, 0.96);
@define-color noti-bg-opaque $BG;
@define-color noti-bg-darker $BG;
@define-color noti-bg-hover rgba($ACCENT_RGB, 0.14);
@define-color noti-bg-hover-opaque $SURFACE;
@define-color noti-bg-focus rgba($ACCENT_RGB, 0.20);
@define-color noti-close-bg rgba($ACCENT_RGB, 0.16);
@define-color noti-close-bg-hover $URGENT;
@define-color text-color $FG;
@define-color text-color-disabled $FG_DIM;
@define-color bg-selected $ACCENT;

@define-color bg $BG;
@define-color bg_alt $BG_ALT;
@define-color bg_bar $BG_RGBA;
@define-color bg_pill $BG_ALT_RGBA;
@define-color surface $SURFACE;
@define-color fg $FG;
@define-color fg_dim $FG_DIM;
@define-color accent $ACCENT;
@define-color accent2 $ACCENT2;
@define-color urgent $URGENT;
@define-color green $GREEN;
@define-color yellow $YELLOW;
@define-color cyan $CYAN;
@define-color orange $ORANGE;
@define-color pink $PINK;
@define-color teal $TEAL;
@define-color dark_text $BG;
EOF

