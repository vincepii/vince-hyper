#!/usr/bin/env bash
# ==============================================================================
# Unified Theme Switcher for Hyprland, Hyprlock, Waybar, Rofi, Kitty, SwayNC, GTK
# ==============================================================================
# Usage:
#   theme-switcher                  # Open interactive Rofi menu
#   theme-switcher "Tokyo Night"    # Apply specified theme and notify
#   theme-switcher --restore        # Restore saved theme quietly at session start
# ==============================================================================

set -euo pipefail

THEME_STATE="$HOME/.config/themes/current"
WALLPAPER_DIR="$HOME/.local/share/wallpapers"

THEMES=(
    "Tokyo Night"
    "Catppuccin Mocha"
    "Gruvbox Dark"
    "Nord"
    "Rose Pine"
    "Everforest"
    "Tokyo Night Day (Light)"
    "Catppuccin Latte (Light)"
    "Gruvbox Light"
    "Rose Pine Dawn (Light)"
    "Everforest Light"
    "Solarized Light"
)

RESTORE_MODE=0
CHOICE="${1:-}"

if [[ "$CHOICE" == "--restore" ]]; then
    RESTORE_MODE=1
    if [[ -f "$THEME_STATE" ]]; then
        CHOICE="$(cat "$THEME_STATE")"
    else
        CHOICE="Tokyo Night"
    fi
fi

select_theme() {
    local current=""
    [[ -f "$THEME_STATE" ]] && current="$(cat "$THEME_STATE")"
    local item
    for item in "${THEMES[@]}"; do
        if [[ "$item" == "$current" ]]; then
            printf '✓ %s\n' "$item"
        else
            printf '  %s\n' "$item"
        fi
    done | rofi -dmenu -no-sidebar-mode -i -p "󰔎 Theme ($current)" -theme-str 'listview {lines: 12;}'
}

if [[ -z "$CHOICE" ]]; then
    if pkill -x rofi 2>/dev/null; then
        exit 0
    fi
    CHOICE="$(select_theme || true)"
fi

# Strip leading checkmark or spaces from interactive Rofi selection
CHOICE="${CHOICE#✓ }"
CHOICE="${CHOICE#  }"

[[ -z "$CHOICE" ]] && exit 0

case "$CHOICE" in
