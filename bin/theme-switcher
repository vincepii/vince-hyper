hex_to_rgb() {
    local hex="${1#\#}"
    printf '%d, %d, %d' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

hex_strip() {
    printf '%s' "${1#\#}"
}

BG_RGB="$(hex_to_rgb "$BG")"
SURF_RGB="$(hex_to_rgb "$SURFACE")"
ACCENT_RGB="$(hex_to_rgb "$ACCENT")"

BG_HEX="$(hex_strip "$BG")"
SURF_HEX="$(hex_strip "$SURFACE")"
FG_HEX="$(hex_strip "$FG")"
ACCENT_HEX="$(hex_strip "$ACCENT")"
URGENT_HEX="$(hex_strip "$URGENT")"
ORANGE_HEX="$(hex_strip "$ORANGE")"
GREEN_HEX="$(hex_strip "$GREEN")"
YELLOW_HEX="$(hex_strip "$YELLOW")"

mkdir -p "$HOME/.config/themes" \
         "$HOME/.config/hypr" \
         "$HOME/.config/waybar" \
         "$HOME/.config/rofi" \
         "$HOME/.config/kitty" \
         "$HOME/.config/swaync" \
         "$HOME/.config/swayosd" \
         "$HOME/.config/qt6ct/colors" \
         "$HOME/.config/gtk-3.0" \
         "$HOME/.config/gtk-4.0"

echo "$NAME" > "$THEME_STATE"

# 1. Hyprland Theme Module (~/.config/hypr/theme.lua) — borders + tabbed groupbar palette
cat > "$HOME/.config/hypr/theme.lua" <<EOF
-- Auto-generated by theme-switcher ($NAME)
return {
    name = "$NAME",
    slug = "$SLUG",
    active_border          = { colors = { "$HYPR_ACTIVE", "$HYPR_ACTIVE2" }, angle = 45 },
    inactive_border        = "$HYPR_INACTIVE",
    group_border_active    = { colors = { "$HYPR_ACTIVE", "$HYPR_ACTIVE2" }, angle = 45 },
    group_border_inactive  = "$HYPR_INACTIVE",
    group_locked_active    = { colors = { "rgba(${URGENT_HEX}ee)", "rgba(${ORANGE_HEX}ee)" }, angle = 45 },
    group_locked_inactive  = "$HYPR_INACTIVE",
    groupbar_active        = "$HYPR_ACTIVE",
    groupbar_inactive      = "rgba(${SURF_HEX}dd)",
    groupbar_locked_active = "rgba(${URGENT_HEX}ee)",
    groupbar_text_active   = "rgba(${BG_HEX}ff)",
    groupbar_text_inactive = "rgba(${FG_HEX}ff)",
    bg = "$BG",
    fg = "$FG",
    accent = "$ACCENT",
}
EOF

# 1b. Hyprlock Theme Colors (~/.config/hypr/hyprlock-colors.conf)
cat > "$HOME/.config/hypr/hyprlock-colors.conf" <<EOF
# Auto-generated by theme-switcher ($NAME)
\$lock_bg       = rgba(${BG_HEX}ff)
\$lock_surface  = rgba(${SURF_HEX}ee)
\$lock_fg       = rgba(${FG_HEX}ff)
\$lock_accent   = rgba(${ACCENT_HEX}ee)
\$lock_check    = rgba(${GREEN_HEX}ee)
\$lock_fail     = rgba(${URGENT_HEX}ee)
\$lock_capslock = rgba(${YELLOW_HEX}ee)
EOF

# 2. Waybar CSS Colors (~/.config/waybar/colors.css)
cat > "$HOME/.config/waybar/colors.css" <<EOF
/* Auto-generated by theme-switcher ($NAME) */
@define-color bg $BG;
@define-color bg_alt $BG_ALT;
@define-color bg_bar $BG_RGBA;
@define-color bg_pill $BG_ALT_RGBA;
@define-color surface $SURFACE;
@define-color fg $FG;
@define-color fg_dim $FG_DIM;
@define-color accent $ACCENT;
@define-color accent2 $ACCENT2;
@define-color urgent $URGENT;
@define-color green $GREEN;
@define-color yellow $YELLOW;
@define-color cyan $CYAN;
@define-color orange $ORANGE;
@define-color pink $PINK;
@define-color teal $TEAL;
@define-color dark_text $BG;
EOF

# 2b. Sync Waybar Clock Calendar Pango Hex Colors (~/.config/waybar/config.jsonc)
if [[ -f "$HOME/.config/waybar/config.jsonc" ]]; then
    python3 - "$HOME/.config/waybar/config.jsonc" "$ACCENT" "$ACCENT2" "$FG" "$FG_DIM" "$BG" "$URGENT" << 'PYEOF'
import json, sys

cfg_path, accent, accent2, fg, fg_dim, bg, urgent = sys.argv[1:8]
with open(cfg_path, "r", encoding="utf-8") as f:
    cfg = json.load(f)

clock = cfg.setdefault("clock", {})
clock["tooltip-format"] = (
    f"<span font_family='JetBrainsMono Nerd Font' size='15pt' weight='bold' color='{accent}'>󰃭  {{:%A, %d %B %Y}}</span>\n\n"
    f"<span font_family='JetBrainsMono Nerd Font' size='16pt' line_height='1.35'>{{calendar}}</span>\n\n"
    f"<span font_family='JetBrainsMono Nerd Font' size='9.5pt' color='{fg_dim}'>󰍽 Scroll: Prev/Next   •   Right-Click: Year View</span>"
)
cal_fmt = clock.setdefault("calendar", {}).setdefault("format", {})
cal_fmt["months"]   = f"<span font_family='JetBrainsMono Nerd Font' color='{accent2}'><b>{{}}</b></span>"
cal_fmt["days"]     = f"<span font_family='JetBrainsMono Nerd Font' color='{fg}'>{{}}</span>"
cal_fmt["weeks"]    = f"<span font_family='JetBrainsMono Nerd Font' color='{fg_dim}'><b>W{{}}</b></span>"
cal_fmt["weekdays"] = f"<span font_family='JetBrainsMono Nerd Font' color='{accent}'><b>{{}}</b></span>"
cal_fmt["today"]    = f"<span font_family='JetBrainsMono Nerd Font' background='{accent}' color='{bg}'><b>{{}}</b></span>"

notif = cfg.get("custom/notification", {}).get("format-icons")
if isinstance(notif, dict):
    dot = f"<span foreground='{urgent}'><sup></sup></span>"
    notif["notification"]               = f"󰂚{dot}"
    notif["dnd-notification"]           = f"󰂛{dot}"
    notif["inhibited-notification"]     = f"󰂚{dot}"
    notif["dnd-inhibited-notification"] = f"󰂛{dot}"

with open(cfg_path, "w", encoding="utf-8") as f:
    json.dump(cfg, f, ensure_ascii=False, indent=2)
    f.write("\n")
PYEOF
fi

# 3. Rofi Theme Colors (~/.config/rofi/colors.rasi)
cat > "$HOME/.config/rofi/colors.rasi" <<EOF
/* Auto-generated by theme-switcher ($NAME) */
* {
    bg:        $BG;
    bg-alt:    $BG_ALT;
    surface:   $SURFACE;
    fg:        $FG;
    fg-dim:    $FG_DIM;
    accent:    $ACCENT;
    accent2:   $ACCENT2;
    urgent:    $URGENT;
}
EOF

