#!/usr/bin/env bash
# Searchable Keybind Cheat Sheet in Rofi
set -euo pipefail

if pkill -x rofi 2>/dev/null; then
    exit 0
fi

cat << 'EOF' | rofi -dmenu -no-sidebar-mode -i -p "󰌌 Keybinds" -theme-str 'window {width: 760px;} listview {lines: 18;}'
Super (Tap) / Super + D / Space │ App Launcher (Rofi: Apps / Windows / Command / Calc)
Super + Tab / Alt + Tab         │ Window Switcher (Rofi) / Cycle Next Window
Super + =                       │ Inline Calculator (Rofi + qalc, auto-copies result)
Super + .                       │ Emoji Picker (rofimoji -> Clipboard)
Super + V                       │ Clipboard History (Rofi + cliphist)
Super + Return                  │ Terminal (Kitty)
Super + B                       │ Browser (Google Chrome)
Super + E                       │ File Manager (Nautilus)
Ctrl + Shift + Escape           │ Toggle Floating System Monitor (btop)
Super + Q / Shift + Q / Super+C │ Close Active Window
Super + F                       │ Toggle Fullscreen (Inhibits Idle)
Super + M                       │ Toggle Maximize (Keep Waybar + Window Count Badge)
Super + Shift + Space           │ Toggle Floating / Tiling Window
Super + P                       │ Toggle Pseudo-Tile (Dwindle)
Super + O / Super + \           │ Toggle Split Orientation (Dwindle)
Super + W                       │ Toggle Tabbed Window Group
Super + Shift + W               │ Move Active Window Out of Tabbed Group
Super + Alt + H / L (or Arrows) │ Previous / Next Window Tab in Group
Super + H / J / K / L (Arrows)  │ Focus Left / Down / Up / Right
Super + Shift + H / J / K / L   │ Move Window Left / Down / Up / Right
Super + Ctrl + H / J / K / L    │ Resize Window Left / Down / Up / Right (40px)
Super + 1..0                    │ Switch to Workspace 1..10
Super + Shift + 1..0            │ Move Window to Workspace 1..10 (Follow)
Super + Ctrl + 1..0             │ Move Window Silently to Workspace 1..10
Super + [ / Super + ]           │ Cycle Previous / Next Workspace
Super + - / Super + S           │ Toggle Scratchpad Special Workspace
Super + Shift + -               │ Move Active Window to Scratchpad
Super + Shift + S / Print       │ Screenshot Region -> Clipboard + Save
Super + Ctrl + S / Shift+Print  │ Screenshot Region -> Annotate / Edit (satty)
Super + Alt + S / Ctrl + Print  │ Screenshot Fullscreen -> Clipboard + Save
Super + Shift + C               │ Color Picker (Hex to Clipboard)
Super + Shift + T               │ Theme Selector (12 Dark & Light Themes)
Super + Ctrl + W                │ Wallpaper Selector (Pictures & System Wallpapers)
Super + N                       │ Toggle Notification Center (SwayNC)
Ctrl + Alt + L / Super + Escape │ Lock Screen Immediately (Hyprlock)
Super + Shift + E               │ Power / Logout Menu (Lock, Suspend, Reboot, Shutdown)
Super + Shift + B / Shift + R   │ Restart Waybar / Reload Hyprland + Waybar
Super + / (or Super + ?)        │ Open Searchable Keybind Cheat Sheet
CapsLock / Super + Ctrl + Space │ Switch US / IT Keyboard Layout (All Devices + OSD)
EOF
