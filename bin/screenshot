#!/usr/bin/env bash
# Screenshot helper using grim + slurp + wl-copy (+ satty/swappy for annotation)
set -euo pipefail

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/screenshot-$(date +'%Y%m%d-%H%M%S').png"

# Read active theme's accent & background hex colors for slurp selection border
ACCENT_HEX="7aa2f7"
BG_HEX="1a1b26"
if [[ -f "$HOME/.config/hypr/theme.lua" ]]; then
    PARSED="$(python3 - "$HOME/.config/hypr/theme.lua" << 'PYEOF' 2>/dev/null || true
import re, sys
txt = open(sys.argv[1], encoding="utf-8").read()
acc = re.search(r'accent\s*=\s*"#([0-9a-fA-F]{6})"', txt)
bg  = re.search(r'bg\s*=\s*"#([0-9a-fA-F]{6})"', txt)
print(f"{acc.group(1) if acc else '7aa2f7'} {bg.group(1) if bg else '1a1b26'}")
PYEOF
)"
    if [[ -n "$PARSED" ]]; then
        read -r ACCENT_HEX BG_HEX <<< "$PARSED"
    fi
fi

select_region() {
    slurp -w 2 -c "${ACCENT_HEX}ff" -b "${BG_HEX}55" 2>/dev/null
}

MODE="${1:-region}"

case "$MODE" in
    region)
        GEOM=$(select_region) || exit 0
        [[ -z "$GEOM" ]] && exit 0
        grim -g "$GEOM" "$FILE"
        ;;
    edit|region-edit)
        GEOM=$(select_region) || exit 0
        [[ -z "$GEOM" ]] && exit 0
        if command -v satty >/dev/null 2>&1; then
            grim -g "$GEOM" - | satty --filename - \
                --output-filename "$FILE" \
                --early-exit \
                --copy-command "wl-copy"
            exit 0
        elif command -v swappy >/dev/null 2>&1; then
            grim -g "$GEOM" - | swappy -f - -o "$FILE"
            [[ -f "$FILE" ]] && wl-copy < "$FILE"
            exit 0
        else
            grim -g "$GEOM" "$FILE"
            wl-copy < "$FILE"
            notify-send -a "Screenshot" -i "$FILE" "Screenshot Captured (Install 'satty' to annotate)" "Copied to clipboard & saved to:\n$(basename "$FILE")"
            exit 0
        fi
        ;;
    full)
        grim "$FILE"
        ;;
    window)
        if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
            GEOM=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
            grim -g "$GEOM" "$FILE"
        else
            grim "$FILE"
        fi
        ;;
    *)
        echo "Usage: screenshot [region|edit|full|window]" >&2
        exit 1
        ;;
esac

wl-copy < "$FILE"

if command -v notify-send >/dev/null 2>&1; then
    if command -v satty >/dev/null 2>&1; then
        (
            ACTION="$(notify-send -a "Screenshot" -i "$FILE" --action="edit=Annotate" \
                "Screenshot Captured" "Copied to clipboard & saved to:\n$(basename "$FILE")" 2>/dev/null || true)"
            if [[ "$ACTION" == "edit" ]]; then
                satty --filename "$FILE" --output-filename "$FILE" --early-exit --copy-command "wl-copy"
            fi
        ) >/dev/null 2>&1 &
    else
        notify-send -a "Screenshot" -i "$FILE" "Screenshot Captured" "Copied to clipboard & saved to:\n$(basename "$FILE")" || true
    fi
fi
