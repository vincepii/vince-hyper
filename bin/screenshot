#!/usr/bin/env bash
# Screenshot helper using grim + slurp + wl-copy (+ satty/swappy for annotation)
set -euo pipefail

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/screenshot-$(date +'%Y%m%d-%H%M%S').png"

MODE="${1:-region}"

case "$MODE" in
    region)
        GEOM=$(slurp 2>/dev/null) || exit 0
        [[ -z "$GEOM" ]] && exit 0
        grim -g "$GEOM" "$FILE"
        ;;
    edit|region-edit)
        GEOM=$(slurp 2>/dev/null) || exit 0
        [[ -z "$GEOM" ]] && exit 0
        if command -v satty >/dev/null 2>&1; then
            grim -g "$GEOM" - | satty --filename - \
                --output-filename "$FILE" \
                --early-exit \
                --copy-command "wl-copy"
            exit 0
        elif command -v swappy >/dev/null 2>&1; then
            grim -g "$GEOM" - | swappy -f - -o "$FILE"
            [[ -f "$FILE" ]] && wl-copy < "$FILE"
            exit 0
        else
            grim -g "$GEOM" "$FILE"
            wl-copy < "$FILE"
            notify-send -a "Screenshot" -i "$FILE" "Screenshot Captured (Install 'satty' to annotate)" "Copied to clipboard & saved to:\n$(basename "$FILE")"
            exit 0
        fi
        ;;
    full)
        grim "$FILE"
        ;;
    window)
        if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
            GEOM=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
            grim -g "$GEOM" "$FILE"
        else
            grim "$FILE"
        fi
        ;;
    *)
        echo "Usage: screenshot [region|edit|full|window]" >&2
        exit 1
        ;;
esac

wl-copy < "$FILE"
notify-send -a "Screenshot" -i "$FILE" "Screenshot Captured" "Copied to clipboard & saved to:\n$(basename "$FILE")"
