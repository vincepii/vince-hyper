@import "~/.config/rofi/colors.rasi"

* {
    background-color:           transparent;
    text-color:                 @fg;
    margin:                     0px;
    padding:                    0px;
    spacing:                    0px;
}

window {
    location:                   center;
    anchor:                     center;
    width:                      540px;
    background-color:           @bg;
    border:                     2px solid;
    border-color:               @accent;
    border-radius:              10px;
    padding:                    14px;
}

mainbox {
    spacing:                    10px;
    children:                   [ inputbar, listview ];
}

inputbar {
    background-color:           @bg-alt;
    border:                     1px solid;
    border-color:               @surface;
    border-radius:              8px;
    padding:                    10px 14px;
    spacing:                    10px;
    children:                   [ prompt, entry ];
}

prompt {
    text-color:                 @accent;
    font:                       "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:                "Type to search...";
    placeholder-color:          @fg-dim;
    text-color:                 @fg;
}

listview {
    lines:                      9;
    columns:                    1;
    fixed-height:               false;
    scrollbar:                  false;
    spacing:                    4px;
    padding:                    4px 0px 0px 0px;
}

element {
    padding:                    8px 12px;
    spacing:                    12px;
    border-radius:              6px;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @fg;
}

element selected.normal {
    background-color:           @surface;
    text-color:                 @accent;
    border:                     1px solid;
    border-color:               @accent;
}

element-icon {
    size:                       24px;
    vertical-align:             0.5;
}

element-text {
    vertical-align:             0.5;
    text-color:                 inherit;
}
