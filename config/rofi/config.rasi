configuration {
    modi:                       "drun,run,window,calc:~/.local/bin/rofi-calc";
    show-icons:                 true;
    display-drun:               "󰀻 Apps";
    display-run:                "󰆍 Run";
    display-window:             "󱂬 Windows";
    display-calc:               "󰪚 Calc";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    font:                       "JetBrainsMono Nerd Font 11";
    icon-theme:                 "Papirus-Dark";
    terminal:                   "kitty";
    kb-remove-to-eol:           "Control+Shift+e";
    kb-accept-entry:            "Return,KP_Enter";
    kb-row-up:                  "Up,Control+k,Control+p";
    kb-row-down:                "Down,Control+j,Control+n";
    kb-matcher-up:              "";
    kb-cancel:                  "Escape,Super+v,Super+c,Super+d,Super+space,Super+Escape,Super+x,Super+slash,Super+question,Super+T,Super+W,Super+equal,Super+period";
}

@theme "~/.config/rofi/theme.rasi"
