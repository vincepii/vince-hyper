configuration {
    modi:                       "drun,window,run,calc:~/.local/bin/rofi-calc";
    sidebar-mode:               true;
    show-icons:                 true;
    display-drun:               " 󰀻  Apps ";
    display-window:             " 󱂬  Windows ";
    display-run:                " 󰆍  Command ";
    display-calc:               " 󰪚  Calc ";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    font:                       "JetBrainsMono Nerd Font 11";
    icon-theme:                 "Papirus-Dark";
    terminal:                   "kitty";
    kb-remove-to-eol:           "Control+Shift+e";
    kb-accept-entry:            "Return,KP_Enter";
    kb-row-up:                  "Up,Control+k,Control+p";
    kb-row-down:                "Down,Control+j,Control+n";
    kb-matcher-up:              "";
    kb-cancel:                  "Escape,Control+g,Super+v,Super+d,Super+space,Super+slash,Super+Shift+T,Super+Ctrl+W,Super+equal,Super+period,Super+Shift+E";
}

@theme "~/.config/rofi/theme.rasi"
