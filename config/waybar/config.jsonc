{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/windowcount",
    "hyprland/submap",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "tray",
    "idle_inhibitor",
    "hyprland/language",
    "custom/clipboard",
    "custom/theme",
    "pulseaudio",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "battery",
    "custom/notification",
    "custom/power"
  ],
  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "Left-click: App Launcher (Super / Super+D)\nRight-click: Window Switcher (Super+Tab)",
    "on-click": "pkill -x rofi || rofi -show drun",
    "on-click-right": "pkill -x rofi || rofi -show window"
  },
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name}",
    "on-click": "activate",
    "on-scroll-down": "hyprctl dispatch workspace e+1",
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4
      ]
    }
  },
  "hyprland/windowcount": {
    "format": "<span/>",
    "format-empty": "<span/>",
    "format-windowed": "<span/>",
    "format-fullscreen": "󰊓 {}",
    "separate-outputs": true,
    "tooltip-format": "Maximized Window (Super+M)\nLeft-click: Unmaximize\nRight-click: Switch Hidden Windows (Super+Tab)",
    "on-click": "hyprctl dispatch fullscreen 1",
    "on-click-right": "pkill -x rofi || rofi -show window"
  },
  "hyprland/submap": {
    "format": "󰌌 {}",
    "tooltip": false
  },
  "hyprland/window": {
    "max-length": 55,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Google Chrome": "  $1",
      "(.*) - Mozilla Firefox": "  $1",
      ".*@.*:(.*)": "  $1"
    }
  },
  "clock": {
    "interval": 1,
    "format": "󰥔 {:%a %d %b  %H:%M:%S}",
    "format-alt": "󰃭 {:%Y-%m-%d  %H:%M:%S}",
    "on-click": "command -v gnome-calendar >/dev/null 2>&1 && (pkill -x gnome-calendar || gnome-calendar) || true",
    "tooltip-format": "<span font_family='JetBrainsMono Nerd Font' size='15pt' weight='bold' color='#7aa2f7'>󰃭  {:%A, %d %B %Y}</span>\n\n<span font_family='JetBrainsMono Nerd Font' size='16pt' line_height='1.35'>{calendar}</span>\n\n<span font_family='JetBrainsMono Nerd Font' size='9.5pt' color='#565f89'>󰍽 Scroll: Prev/Next   •   Right-Click: Year View</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span font_family='JetBrainsMono Nerd Font' color='#bb9af7'><b>{}</b></span>",
        "days": "<span font_family='JetBrainsMono Nerd Font' color='#c0caf5'>{}</span>",
        "weeks": "<span font_family='JetBrainsMono Nerd Font' color='#565f89'><b>W{}</b></span>",
        "weekdays": "<span font_family='JetBrainsMono Nerd Font' color='#7aa2f7'><b>{}</b></span>",
        "today": "<span font_family='JetBrainsMono Nerd Font' background='#7aa2f7' color='#1a1b26'><b>{}</b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "max-length": 36,
    "dynamic-order": [
      "title",
      "artist"
    ],
    "player-icons": {
      "default": "󰎆",
      "spotify": "",
      "firefox": "",
      "chromium": "",
      "google-chrome": ""
    },
    "status-icons": {
      "paused": "󰏤"
    }
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶 Awake",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Idle Inhibitor: ACTIVE (Screen will stay awake)",
    "tooltip-format-deactivated": "Idle Inhibitor: OFF (Click to keep screen awake)"
  },
  "hyprland/language": {
    "format": "󰌌 {}",
    "format-en": "US",
    "format-it": "IT",
    "tooltip-format": "Keyboard Layout (CapsLock / Super+Ctrl+Space to switch)",
    "on-click": "$HOME/.local/bin/switch-layout"
  },
  "custom/clipboard": {
    "format": "󰅌",
    "tooltip-format": "Clipboard History (Super+V)\nRight-click to wipe",
    "on-click": "$HOME/.local/bin/clipboard-menu",
    "on-click-right": "$HOME/.local/bin/clipboard-menu --clear"
  },
  "custom/theme": {
    "format": "󰔎",
    "tooltip-format": "Left-click: Switch Theme (Super+Shift+T)\nRight-click: Switch Wallpaper (Super+Ctrl+W)",
    "on-click": "$HOME/.local/bin/theme-switcher",
    "on-click-right": "$HOME/.local/bin/wallpaper-switcher"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 Wired",
    "format-disconnected": "󰤭 Offline",
    "tooltip-format": "{ifname} via {gwaddr}\nIP: {ipaddr}/{cidr}\nDown: {bandwidthDownBits} | Up: {bandwidthUpBits}",
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },
  "cpu": {
    "interval": 3,
    "format": "󰍛 {usage}%",
    "tooltip-format": "CPU Usage: {usage}%\nClick to toggle floating btop",
    "on-click": "pkill -f 'kitty --class floating-btop' || kitty --class floating-btop -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "󰘚 {percentage}%",
    "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB used\nClick to toggle floating btop",
    "on-click": "pkill -f 'kitty --class floating-btop' || kitty --class floating-btop -e btop"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚<span foreground='#f7768e'><sup></sup></span>",
      "none": "󰂜",
      "dnd-notification": "󰂛<span foreground='#f7768e'><sup></sup></span>",
      "dnd-none": "󰪑",
      "inhibited-notification": "󰂚<span foreground='#f7768e'><sup></sup></span>",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛<span foreground='#f7768e'><sup></sup></span>",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Power Menu (Super+Shift+E)",
    "on-click": "$HOME/.local/bin/power-menu"
  }
}
